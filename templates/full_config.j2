{#
  Device configuration rendered entirely from one GraphQL response (Lab 2).

  Every value below comes from `device`, the result of a single query against
  Nautobot (graphql/device_intent.gql). No REST round-trips, group_vars or survey.

  The `default()` guards are deliberate: a Config Context need not define every
  key, and a device need not have VLANs or descriptions.
#}
hostname {{ device.name }}
!
{% if device.config_context is defined and device.config_context %}
{% for server in device.config_context.get('ntp_servers', []) %}
ntp server {{ server }}
{% endfor %}
!
{% for server in device.config_context.get('dns_servers', []) %}
ip name-server {{ server }}
{% endfor %}
!
{% if device.config_context.get('snmp_community') %}
snmp-server community {{ device.config_context['snmp_community'] }} ro
{% endif %}
{% if device.config_context.get('syslog_host') %}
logging host {{ device.config_context['syslog_host'] }}
{% endif %}
{% endif %}
!
{#
  Never render config for the management (out-of-band) interface.

  Applying intent to the interface you are connected through can disconnect
  you mid-commit: a wrong address in Nautobot would renumber the interface, drop
  the SSH session, and leave the job timing out after the device has changed.
  Skipping management interfaces means no data error in Nautobot can take a
  device off the network.

  `default(false)`: if the query ever stops returning mgmt_only, interfaces are
  still rendered, rather than all being skipped and producing an empty intent
  that looks like "no drift".
#}
{% for intf in device.interfaces | default([]) if not intf.get('mgmt_only', false) %}
interface {{ intf.name }}
{% if intf.description %}
   description {{ intf.description }}
{% else %}
   description managed by Nautobot
{% endif %}
{% for ip in intf.ip_addresses | default([]) %}
   ip address {{ ip.address }}
{% endfor %}
{% if intf.untagged_vlan %}
   switchport access vlan {{ intf.untagged_vlan.vid }}
{% endif %}
{% if intf.tagged_vlans %}
   switchport trunk allowed vlan {{ intf.tagged_vlans | map(attribute='vid') | join(',') }}
{% endif %}
{% if not intf.enabled %}
   shutdown
{% endif %}
!
{% endfor %}
