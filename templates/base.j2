{#
  Base configuration template (Lab 0).

  When launched from AWX with the survey enabled, the survey answers arrive as
  extra_vars, which outrank group_vars: values an operator types win over the
  source of truth.

  Lab 2 reuses this template unchanged once the values come from Nautobot
  Config Contexts instead of group_vars.
#}
hostname {{ inventory_hostname }}
!
{% for server in ntp_servers %}
ntp server {{ server }}
{% endfor %}
!
{% for server in dns_servers %}
ip name-server {{ server }}
{% endfor %}
!
snmp-server community {{ snmp_community }} ro
!
logging host {{ syslog_host }}
!
